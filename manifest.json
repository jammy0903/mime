{
  "manifest_version": 3,
  "name": "밈 레이더",
  "version": "1.0.0",
  "description": "한국 커뮤니티에서 유행하는 밈과 표현을 자동으로 찾아주는 확장프로그램",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://gall.dcinside.com/*",
    "*://www.fmkorea.com/*",
    "*://www.instiz.net/*",
    "*://www.yeosig.com/*",
    "*://yeosig.com/*",
    "*://api.anthropic.com/*",
    "*://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
